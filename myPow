class Solution {
    public double myPow(double x, int n) {
        return Math.pow(x,n);
    }
    public static void main(String[] args)
    {
    double x = 2.000000;
    int n=10;
    Solution sol = new Solution();
    double result = sol.myPow(x,n);
    System.out.println("The power is "+ result);
}
}
