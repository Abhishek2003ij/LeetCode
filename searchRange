class Solution {
    private int lower(int l, int h, int[] nums, int target) {

        while (l <= h) {
            int mid = (l + h) / 2;

            if (nums[mid] >= target) {
                h = mid - 1;
            } else {
                l = mid + 1;
            }
        }

        return l;
    }

    private int high(int l, int h, int[] nums, int target) {

        while (l <= h) {
            int mid = (l + h) / 2;

            if (nums[mid] > target) {
                h = mid - 1;
            } else {
                l = mid + 1;
            }
        }

        return l;
    }

    public int[] searchRange(int[] nums, int target) {

        int n = nums.length;

        int l = 0;
        int h = n - 1;

        int lb = lower(l, h, nums, target);
        int hb = high(l, h, nums, target);

        if (lb == n || nums[lb] != target) {
            return new int[]{-1, -1};
        }

        return new int[]{lb, hb - 1};
    }
}
