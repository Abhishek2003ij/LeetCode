class Solution {

    private int lb(int[] nums, int target) {
        int l = 0;
        int h = nums.length - 1;
        int ans = -1;

        while (l <= h) {
            int mid = l + (h - l) / 2;

            if (nums[mid] >= target) {
                if (nums[mid] == target)
                    ans = mid;
                h = mid - 1;
            } else {
                l = mid + 1;
            }
        }

        return ans;
    }

    private int hb(int[] nums, int target) {
        int l = 0;
        int h = nums.length - 1;
        int ans = -1;

        while (l <= h) {
            int mid = l + (h - l) / 2;

            if (nums[mid] <= target) {
                if (nums[mid] == target)
                    ans = mid;
                l = mid + 1;
            } else {
                h = mid - 1;
            }
        }

        return ans;
    }

    public int[] searchRange(int[] nums, int target) {
        return new int[] {
            lb(nums, target),
            hb(nums, target)
        };
    }
}
