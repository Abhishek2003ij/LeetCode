/* The isBadVersion API is defined in the parent class VersionControl.
      boolean isBadVersion(int version); */

public class Solution extends VersionControl {
    public int firstBadVersion(int n) {
        int l = 1; // Versions start at 1, not 0
        int h = n;
        
        while (l < h) {
            // 1. FIXED: Correct and overflow-safe midpoint
            int mid = l + (h - l) / 2; 
            
            if (isBadVersion(mid)) {
                // 2. FIXED: Keep mid in the pool because it might be the first bad version
                h = mid; 
            } else {
                l = mid + 1;
            }
        }
        return l; // l and h meet at the first bad version
    }
}
