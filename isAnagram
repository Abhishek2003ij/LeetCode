class Solution {
    public boolean isAnagram(String s, String t) {
        int m = s.length();
        int n = t.length();
        if(m!=n){
            return false;
        }
        Map<Character, Integer> map = new HashMap<>();
        for(char temp:s.toCharArray()){
            map.put(temp, map.getOrDefault(temp,0)+1);
        }
        for(char temp:t.toCharArray()){
            if(!map.containsKey(temp)){
                return false;
            }
            map.put(temp, map.getOrDefault(temp,0)-1);
            if(map.get(temp)==0){
                map.remove(temp);
            }
        }
        return map.size()==0;

        
    }
}
