import java.util.Stack;

class Solution { 
    public boolean isValid(String s) { 
        Stack<Character> st = new Stack<>(); 
        for(char temp:s.toCharArray()){ 
            if(temp == '[' || temp == '{' || temp == '('){ 
                st.push(temp); 
            } 
            else if(temp == ']' && !st.isEmpty() && st.peek() == '['){ 
                st.pop(); 
            } 
            else if(temp == '}' && !st.isEmpty() && st.peek() == '{'){ 
                st.pop(); 
            } 
            else if(temp == ')' && !st.isEmpty() && st.peek() == '('){ 
                st.pop(); 
            } 
            else {
                return false;
            }
        } 
        return st.isEmpty(); 
    } 
}
