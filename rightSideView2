import java.util.*;

class Solution {
    public List<Integer> rightSideView(TreeNode root) {
        List<Integer> res = new ArrayList<>();
        if (root == null) {
            return res; // Fixed: return the empty result list, not the root
        }
        
        Queue<TreeNode> q = new LinkedList<>(); // Fixed: added missing variable name 'q'
        q.add(root);
        
        while (!q.isEmpty()) {
            int n = q.size();
            TreeNode cur = null; // Declare outside the loop to access after the loop
            
            for (i = 0; i < n; i++) {
                cur = q.poll(); // Fixed: use 'poll()' instead of 'pop()' for a Queue
                
                if (cur.left != null) {
                    q.add(cur.left);
                }
                if (cur.right != null) {
                    q.add(cur.right);
                }
            }
            // After the loop finishes, 'cur' holds the very last node of this level
            res.add(cur.val); 
        }
        return res;
    }
}
