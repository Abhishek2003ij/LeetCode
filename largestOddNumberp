class Solution {
    public String largestOddNumber(String num) {
        int n = num.length();
        while(n>0){
            char temp = num.charAt(n-1);
            int val = temp - '0';
            if(val%2!=0){
                return num.substring(0,n);
            }
            else{
                n--;
            }
            

        }
        return "";
        
    }
}
