class Solution {
    public boolean closeStrings(String word1, String word2) {
        int m = word1.length();
        int n = word2.length();
        if(n!=m) return false;
        Map<Character, Integer> str1 = new HashMap<>();
        Map<Character, Integer> str2  = new HashMap<>();
        for(int i =0;i<m;i++){
            char temp = word1.charAt(i);
            str1.put(temp, str1.getOrDefault(temp,0 )+1);
        }
          for(int i =0;i<n;i++){
            char temp = word2.charAt(i);
            str2.put(temp, str2.getOrDefault(temp,0 )+1);
        }
        if(!str1.keySet().equals(str2.keySet())){
            return false;
        }
        List<Integer> freq1 = new ArrayList<>(str1.values());
        List<Integer> freq2 = new ArrayList<>(str2.values());
        Collections.sort(freq1);
        Collections.sort(freq2);
        

        return  freq1.equals(freq2);
    }
}
